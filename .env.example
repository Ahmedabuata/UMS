# ============================================================
# UMS Environment Variables — EXAMPLE
# ============================================================
# This is a TEMPLATE file for the UMS Docker Compose stack.
#
# HOW TO USE:
#   1. Copy this file to .env:
#        cp .env.example .env
#   2. Replace all REPLACE_ME values with real secrets.
#   3. NEVER commit the actual .env file to Git.
#
# ⚠️ The .env file MUST be listed in .gitignore
# ============================================================

# ============================================================
# PostgreSQL — Database Names
# ============================================================
# Used by: hr-db, identity-db, connection strings

UMS_DB_NAME=ums_db
HR_DB_NAME=hr_microservice_db
IDENTITY_DB_NAME=identity_db

# ============================================================
# PostgreSQL — Shared Database User
# ============================================================
# Used by: all PostgreSQL containers and connection strings

DB_USER=ums_user

# ============================================================
# PostgreSQL — Passwords (SECRETS)
# ============================================================
# Used by: hr-db, identity-db, ums-db
# Generate strong passwords: openssl rand -base64 24

POSTGRES_UMS_PASSWORD=REPLACE_ME
POSTGRES_HR_PASSWORD=REPLACE_ME
POSTGRES_IDENTITY_PASSWORD=REPLACE_ME

# ============================================================
# Connection Strings (Docker internal hostnames)
# ============================================================
# Uses ${VAR} interpolation — values come from above
# Format: Host=<service>;Port=5432;Database=<db>;Username=<user>;Password=<pass>

CONNECTION_UMS_DB=Host=ums-db;Port=5432;Database=${UMS_DB_NAME};Username=${DB_USER};Password=${POSTGRES_UMS_PASSWORD}
CONNECTION_HR_DB=Host=hr-db;Port=5432;Database=${HR_DB_NAME};Username=${DB_USER};Password=${POSTGRES_HR_PASSWORD}
CONNECTION_IDENTITY_DB=Host=identity-db;Port=5432;Database=${IDENTITY_DB_NAME};Username=${DB_USER};Password=${POSTGRES_IDENTITY_PASSWORD}

# ============================================================
# JWT Configuration (SECRETS)
# ============================================================
# JWT_KEY           → minimum 64 chars (HS256 symmetric key)
# JWT_REFRESH_PEPPER → minimum 32 chars (pepper for refresh tokens)
# Generate: openssl rand -base64 48

JWT_KEY=REPLACE_WITH_MIN_64_CHARS
JWT_REFRESH_PEPPER=REPLACE_WITH_MIN_32_CHARS
JWT_ISSUER=Identity.Api
JWT_AUDIENCE=identity-web

# ============================================================
# RabbitMQ
# ============================================================
# ⚠️ WARNING: 'guest' user only works on localhost.
#    For Docker, create a dedicated user in production.

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=REPLACE_ME

# ============================================================
# Email — SMTP (Mailtrap for development)
# ============================================================
# For production, replace with SendGrid / AWS SES / etc.

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME

# ============================================================
# ASP.NET Core Environment
# ============================================================
# Values: Development | Staging | Production | Docker

ASPNETCORE_ENVIRONMENT=Docker