# ============================================================
# UMS Environment Variables — EXAMPLE
# Copy this to .env and fill with real values
# NEVER commit .env
# ============================================================

# PostgreSQL Passwords
POSTGRES_UMS_PASSWORD=REPLACE_ME
POSTGRES_HR_PASSWORD=REPLACE_ME
POSTGRES_IDENTITY_PASSWORD=REPLACE_ME

# Connection Strings (Docker internal hostnames)
CONNECTION_UMS_DB=Host=ums-db;Port=5432;Database=ums_db;Username=ums_user;Password=REPLACE_ME
CONNECTION_HR_DB=Host=hr-db;Port=5432;Database=hr_microservice_db;Username=ums_user;Password=REPLACE_ME
CONNECTION_IDENTITY_DB=Host=identity-db;Port=5432;Database=identity_db;Username=ums_user;Password=REPLACE_ME

# JWT
JWT_KEY=REPLACE_WITH_MIN_64_CHARS
JWT_REFRESH_PEPPER=REPLACE_WITH_MIN_32_CHARS

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=REPLACE_ME

# Email (Mailtrap)
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME