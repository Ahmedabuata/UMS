  "PasswordPolicy": {
    "MinLength": 8,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSpecialCharacter": true
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 5, "WindowMinutes": 1 },
    "Api": { "PermitLimit": 100, "WindowMinutes": 1 }
  },
  "EmailSettings": {
    "SmtpHost": "sandbox.smtp.mailtrap.io",
    "SmtpPort": 2525,
    "SmtpUser": "REPLACE_ME",
    "SmtpPass": "REPLACE_ME",
    "FromEmail": "noreply@ums.local",
    "FromName": "UMS System",
    "EnableSsl": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
