{
  "ConnectionStrings": {
    "IdentityDb": "Host=localhost;Port=5432;Database=identity_db;Username=REPLACE_ME;Password=REPLACE_ME"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_MIN_64_CHARS_SECRET_FOR_HS256",
    "Issuer": "Identity.Api",
    "Audience": "identity-web",
    "AccessTokenMinutes": "30",
    "RefreshTokenDays": "7",
    "RefreshTokenPepper": "REPLACE_WITH_MIN_32_CHARS_PEPPER"
