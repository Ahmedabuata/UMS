{
  "ConnectionStrings": {
    "IdentityDb": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "Identity.Api",
    "Audience": "identity-web",
    "AccessTokenMinutes": "30",
    "RefreshTokenDays": "7",
    "RefreshTokenPepper": ""
  },
  "PasswordPolicy": {
    "MinLength": 8,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSpecialCharacter": true
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 5,
      "WindowMinutes": 1
    },
    "Api": {
      "PermitLimit": 100,
      "WindowMinutes": 1
    }
  },
  "EmailSettings": {
    "SmtpHost": "sandbox.smtp.mailtrap.io",
    "SmtpPort": 2525,
    "SmtpUser": "",
    "SmtpPass": "",
    "FromEmail": "noreply@ums.local",
    "FromName": "UMS System",
    "EnableSsl": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
