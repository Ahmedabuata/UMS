# ============================================================
# identity-web/.env.example
# ============================================================
# Copy this file to .env and adjust values for your environment.
#
# ⚠️ IMPORTANT SECURITY NOTE:
#   Any variable starting with VITE_ will be EMBEDDED into the
#   final JavaScript bundle and visible to ALL users.
#
#   NEVER put secrets here (passwords, API keys, JWT secrets).
#   For secrets, use the Backend (Identity.Api User Secrets).
#
# ============================================================

# ------------------------------------------------------------
# API Configuration (PUBLIC — safe for VITE_*)
# ------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_BASE=http://localhost:5000

# ------------------------------------------------------------
# App Metadata (PUBLIC)
# ------------------------------------------------------------
VITE_APP_VERSION=1.2.0
VITE_API_VERSION=v1

# ------------------------------------------------------------
# ❌ NEVER ADD THESE (even with VITE_ prefix):
# ------------------------------------------------------------
#   VITE_SECRET_KEY=...
#   VITE_DB_PASSWORD=...
#   VITE_JWT_KEY=...
#   VITE_API_SECRET=...
#   VITE_SMTP_PASSWORD=...
#
# These would be exposed in the JavaScript bundle.
# Use the Backend for secrets management.
# ============================================================
